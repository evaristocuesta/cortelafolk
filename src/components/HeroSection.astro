---
import Icon from './Icon.astro';
---
<section id="home" class="hero" aria-labelledby="hero-title">
	<div class="container hero-inner">
		<div class="hero-meta"><span><span class="small-star" aria-hidden="true">✳</span> MÚSICA CON RAÍCES. ESPÍRITU LIBRE.</span><span>4.ª EDICIÓN <span aria-hidden="true">↗</span></span></div>
		<div class="hero-title-wrap">
			<h1 id="hero-title">CORTELA<span>FOLK<span class="title-star" aria-hidden="true">✳</span></span></h1>
			<div class="hero-stamp"><span>PARA TODO</span><strong>EL MUNDO</strong><span>ENTRADA GRATUITA</span><Icon name="sun" /></div>
		</div>
		<div class="hero-bottom">
			<div class="hero-copy"><p>Tres días para sentir la música.<br />Un pueblo para encontrarnos.</p><p class="hero-access-line">ENTRADA GRATUITA · SIN RESERVAS</p><a class="button button-orange" href="#schedule">EXPLORA EL FESTIVAL <Icon name="arrow" /></a></div>
			<div class="hero-date"><strong>23 · 24 · 25</strong><span>ABRIL 2027</span><p><Icon name="pin" /> CORTELAZOR · HUELVA</p></div>
		</div>
	</div>
	<img class="hero-landscape" src="/images/hero-landscape.svg" alt="" width="1600" height="430" fetchpriority="high" />
	<a class="hero-scroll" href="#festival" aria-label="Descubre el festival"><span aria-hidden="true">↓</span></a>
</section>
<div class="festival-ribbon" aria-label="Música, sierra, cultura y entrada gratuita">
	<div><span>ENTRADA GRATUITA</span><span aria-hidden="true">✳</span><span>MÚSICA CON RAÍCES</span><span aria-hidden="true">✳</span><span>EN PLENA SIERRA</span><span aria-hidden="true">✳</span><span>23 · 24 · 25 ABRIL</span><span aria-hidden="true">✳</span><span>CORTELAZOR, HUELVA</span><span aria-hidden="true">✳</span></div>
</div>
