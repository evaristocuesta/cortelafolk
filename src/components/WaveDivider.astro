---
interface Props {
	nextColor?: 'paper' | 'tangerine' | 'forest' | 'moss';
	variant?: 'thick';
}

const { nextColor = 'paper', variant } = Astro.props;
const thick = variant === 'thick';
const wave = 'M0 17C46.67 13 76.67 1.83 130 4C183.33 6.17 241.67 29.83 320 30C398.33 30.17 518.33 5.33 600 5C681.67 4.67 750 26 810 28C870 30 913.33 21 960 17';
const lowerWave = 'M960 37C913.33 41 870 50 810 48C750 46 681.67 24.67 600 25C518.33 25.33 398.33 50.17 320 50C241.67 49.83 183.33 26.17 130 24C76.67 21.83 46.67 33 0 37';
const thickFill = `${wave}L${lowerWave.slice(1)}Z`;
---
<svg class:list={['section-wave', { 'section-wave--thick': thick }]} viewBox={`0 0 960 ${thick ? 174 : 34}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
	<path d={thick ? thickFill : `${wave}V34H0Z`} fill={`var(--color-${nextColor})`} />
	<path d={wave} fill="none" stroke="var(--ink)" stroke-opacity=".19" vector-effect="non-scaling-stroke" />
	{thick && <path d={lowerWave} fill="none" stroke="var(--ink)" stroke-opacity=".19" vector-effect="non-scaling-stroke" />}
</svg>
