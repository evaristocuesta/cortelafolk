---
import { activities } from '../data/activities';
import { festivalDays } from '../data/site';
import ActivityCard from './ActivityCard.astro';
import ProfileDialog from './ProfileDialog.astro';
import SectionHeading from './SectionHeading.astro';
import PageContainer from './PageContainer.astro';
import WaveDivider from './WaveDivider.astro';

// Seed record keeps the dialog markup complete before JavaScript enhances it.
const sampleActivity = activities[0];
---
<section id="actividades" class="activities-section py-15 sm:pb-[75px] tablet:pb-26">
	<PageContainer>
		<SectionHeading eyebrow="MUCHO MÁS QUE CONCIERTOS" title="VEN POR LA MÚSICA. QUÉDATE POR TODO." titleClass="max-w-[630px]" text="La mejor parte de un festival también sucede entre canciones." />
		<div class="grid grid-cols-1 gap-[34px] sm:gap-7 lg:grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))]">
			{festivalDays.map((day) => (
				<section class="activity-day" data-activity-day={day.id} aria-labelledby={`activity-day-${day.id}`}>
					<div class="artist-day-heading flex items-center justify-between bg-forest px-3.5 py-[15px] text-paper sm:py-5">
						<h3 id={`activity-day-${day.id}`}>{day.label}</h3><span>{day.date}<small>ABRIL</small></span>
					</div>
					<div class="flex flex-col gap-6 pt-6 sm:gap-7 sm:pt-7">
						{activities.filter((activity) => activity.day === day.id).map((activity) => <ActivityCard activity={activity} />)}
					</div>
				</section>
			))}
		</div>
		<p class="artist-footnote">Distintas formas de vivir el mismo festival.</p>
		<ProfileDialog variant="activity" sample={sampleActivity} />
	</PageContainer>
	<WaveDivider nextColor="tangerine" />
</section>
<script>
	import { bindProfileDialog } from '../scripts/profile-dialog';
	bindProfileDialog('[data-activity-dialog]', '[data-activity-open]');
</script>
