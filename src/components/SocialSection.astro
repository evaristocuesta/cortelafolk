---
import Icon from './Icon.astro';
import PageContainer from './PageContainer.astro';
---
<section class="bg-moss py-[45px] sm:py-[58px]" aria-labelledby="social-title">
	<PageContainer class="social-inner flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center sm:gap-10">
		<div><p class="eyebrow">LOS BUENOS PLANES SE COMPARTEN</p><h2 id="social-title">¿A QUIÉN TE TRAES?</h2><p>Pásale el plan a esa persona con la que siempre acabas bailando.</p></div>
		<div class="share-actions max-w-80"><button class="button button-cream inline-flex items-center justify-between gap-8" type="button" data-share hidden>COMPARTE EL FESTIVAL <Icon name="share" /></button><p data-share-status role="status" aria-live="polite"></p></div>
	</PageContainer>
</section>
<script>
	const shareButton = document.querySelector<HTMLButtonElement>('[data-share]');
	if (shareButton && (navigator.share || navigator.clipboard)) {
		shareButton.hidden = false;
		shareButton.addEventListener('click', async () => {
			const status = document.querySelector('[data-share-status]');
			const url = `${window.location.origin}${window.location.pathname}`;
			try {
				if (navigator.share) {
					await navigator.share({ title: 'Cortelafolk 2027', text: '23, 24 y 25 de abril en Cortelazor, Huelva. ¡Entrada gratuita para todo el mundo!', url });
				} else {
					await navigator.clipboard.writeText(url);
					if (status) status.textContent = '¡Enlace copiado! Compártelo con quien quieras.';
				}
			} catch (error) {
				if (error instanceof DOMException && error.name === 'AbortError') return;
				if (status) status.textContent = 'No se ha podido compartir. Puedes copiar el enlace desde la barra de tu navegador.';
			}
		});
	}
</script>
