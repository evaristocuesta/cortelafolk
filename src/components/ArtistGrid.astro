---
import { artists } from '../data/artists';
import ArtistCard from './ArtistCard.astro';
import SectionHeading from './SectionHeading.astro';
---
<section id="artists" class="section artists-section">
	<div class="container">
		<SectionHeading eyebrow="SONIDOS QUE NOS UNEN" title="RAÍCES Y NUEVOS AIRES." text="Folk, tradición y músicas que no entienden de fronteras. Así suena el espíritu de Cortelafolk." />
		<div class="programme-note"><span class="status-dot" aria-hidden="true"></span><p><strong>Cartel en preparación.</strong> Esta selección es orientativa; los artistas definitivos se anunciarán aquí.</p></div>
		<div class="artist-grid">{artists.map((artist) => <ArtistCard artist={artist} />)}</div>
		<p class="artist-footnote">Diferentes sonidos. Un mismo lugar de encuentro.</p>
	</div>
</section>
