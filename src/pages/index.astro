---
import '../styles/global.css';
import { site } from '../data/site';

const productionOrigin = import.meta.env.PUBLIC_SITE_URL;
const canonicalUrl = productionOrigin ? new URL('/', productionOrigin).href : undefined;
const socialImageUrl = canonicalUrl ? new URL('/images/social-preview.png', canonicalUrl).href : undefined;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#173d2d" />
		<meta name="description" content={site.description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:title" content="Cortelafolk 2027" />
		<meta property="og:description" content={site.description} />
		<meta property="og:site_name" content={site.name} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Cortelafolk 2027" />
		<meta name="twitter:description" content={site.description} />
		{canonicalUrl && <><link rel="canonical" href={canonicalUrl} /><meta property="og:url" content={canonicalUrl} /></>}
		{socialImageUrl && <><meta property="og:image" content={socialImageUrl} /><meta property="og:image:type" content="image/png" /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Cortelafolk 2027: música con raíces en Cortelazor, del 23 al 25 de abril. Entrada libre." /><meta name="twitter:image" content={socialImageUrl} /><meta name="twitter:image:alt" content="Cortelafolk 2027, del 23 al 25 de abril en Cortelazor. Entrada libre." /></>}
		<link rel="preload" href="/fonts/barlow-condensed-latin-800.woff2" as="font" type="font/woff2" crossorigin />
		<title>Cortelafolk 2027 · 23, 24 y 25 de abril</title>
	</head>
	<body class="landing-page relative flex min-h-dvh flex-col items-center justify-center overflow-hidden bg-forest-light px-6 py-12 text-center text-paper antialiased">
		<div class="relative z-[2] flex flex-col items-center gap-10 sm:gap-12 tablet:gap-14">
			<img class="landing-logo" src="/images/logo.webp" alt="Cortelafolk" width="716" height="401" fetchpriority="high" />
			<div class="landing-content flex flex-col items-center gap-2 text-[11px] font-semibold tracking-[.12em] sm:flex-row sm:gap-4">
				<span>{site.edition}</span>
				<span class="hidden sm:inline" aria-hidden="true">✳</span>
				<span>{site.location}</span>
				<span class="hidden sm:inline" aria-hidden="true">✳</span>
				<span class="landing-free">ENTRADA LIBRE</span>
			</div>
			<p class="landing-dates">23 · 24 · 25<span>ABRIL 2027</span></p>
		</div>
		<img class="landing-landscape" src="/images/hero-landscape.svg" alt="" width="1600" height="430" />
	</body>
</html>
